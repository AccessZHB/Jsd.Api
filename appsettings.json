{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // 数据库连接字符串（数据库名：jingsuding_order）
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=jingsuding_order;User ID=root;Password=123456;Charset=utf8mb4;"
  },

  // 字典缓存配置（字典管理模块）
  // CacheMinutes：缓存过期时间（分钟）；EmptyCacheMinutes：查不到数据时空结果的缓存时间，防缓存穿透
  "Dict": {
    "CacheMinutes": 30,
    "EmptyCacheMinutes": 5
  },

  // JWT 配置（注意：代码中统一读取 Jwt: 这一节的键名，不要随意改名）
  "Jwt": {
    "Issuer": "jingsuding",
    "Audience": "jingsuding-admin",
    "SecretKey": "JingSuDingOrderSystem2026JwtSecretKey_MustBeLongEnough32+",
    "ExpireMinutes": 720
  },

  // 会员（小程序）登录安全策略 —— F-25 / 阶段三
  // CaptchaEnabled=true 时登录必须先通过图形验证码（前端需先调 POST /api/member/captcha）
  // 缓存层限流规则固定写在 LoginAttemptLimiter：60 秒内失败 5 次 → 锁定 15 分钟
  // 下面的次数/时长用于 DB 持久化兜底（服务重启后仍生效），请与缓存层保持一致
  "Security": {
    "MemberLogin": {
      "CaptchaEnabled": true,
      "MaxLoginAttempts": 5,
      "LockDurationMinutes": 15
    }
  },

  // 会员自助充值（阶段六 · 资损加固）
  // Enabled=false：直接拒绝在线充值（未接微信支付前必须保持 false，否则会员可凭空造余额）
  // 接入微信支付后：由支付回调入账，并关闭本接口的"直接入账"逻辑
  // 演示环境可临时置 true（单笔不超过 MaxAmount）
  "Wallet": {
    "SelfRecharge": {
      "Enabled": false,
      "MaxAmount": 5000
    }
  },

  // 物流轨迹查询配置（快递100 / 快递鸟，按实际注册平台调整）
  // Mock=true 时返回演示数据，无需真实密钥即可开发/演示；配置好 Key/Customer 后把 Mock 改为 false 走真实接口。
  // 注意：快递100 实时查询需要 Key（授权密钥）+ Customer（授权码）两项；Secret 预留给快递鸟等其它平台。
  "Logistics": {
    "Provider": "Kuaidi100",
    "Key": "",
    "Customer": "",
    "Secret": "",
    "CacheMinutes": 60,
    "Mock": true
  },

  // 微信支付 V3 配置（微信支付主动查单与补单模块）
  // 未配置时 PayService 的回调/查单接口会直接返回失败（不影响应用启动与其它功能）。
  // MerchantPrivateKey / PlatformPublicKey 填 PEM 全文（含 -----BEGIN ...----- 与结尾行，用 \n 换行）。
  "WeChatPay": {
    "MchId": "",
    "AppId": "",
    "ApiV3Key": "",
    "MerchantPrivateKey": "",
    "MerchantSerialNo": "",
    "PlatformPublicKey": "",
    "PlatformCertSerialNo": "",
    "BaseUrl": "https://api.mch.weixin.qq.com",
    "NotifyUrl": ""
  },

  // 阶段七：早期的「无验签」回调通道 /api/payment-callback/wechat 默认停用。
  // 任何人都能 POST 伪造 JSON 把订单置为已支付，正式回调请使用 /api/pay/notify（V3 真实验签）。
  // 仅在灰度排查时临时置 true。
  "WeChat": {
    "LegacyCallbackEnabled": false
  },

  // 发票与税务管理模块 —— 第三方开票平台配置（可全部留空）
  // Provider / ApiUrl 任一为空，或 Mock=true 时：开票申请只落库为「申请中」，由财务人工开票后回写票号。
  // 对接后（如百望云、航信）：填好 ApiUrl + AppKey + AppSecret 并把 Mock 改为 false，
  // 申请即自动调用开票接口，成功回写发票号码并把状态置为「已开票」。
  "Invoice": {
    "Provider": "",
    "ApiUrl": "",
    "AppKey": "",
    "AppSecret": "",
    "Mock": true
  }
}
